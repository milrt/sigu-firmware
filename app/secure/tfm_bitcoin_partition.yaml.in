{
  "psa_framework_version": 1.1,
  "name": "TFM_SP_BITCOIN",
  "type": "APPLICATION-ROT",
  "priority": "NORMAL",
  "model": "IPC",
  "entry_point": "tfm_bitcoin_init",
  "stack_size": "0x4000",
  "services":
    [
      {
        "name": "TFM_BITCOIN",
        "sid": "0xFFFFF001",
        "non_secure_clients": true,
        "connection_based": true,
        "version": 3,
        "version_policy": "STRICT",
      },
@SIGU_TEST_SERVICE@
    ],
  # The SPU makes a peripheral secure only when a partition names it here, also at isolation
  # level 1. CONFIG_NRF_*_SECURE only allows the name. GPIO pins use the pin mask instead.
  "mmio_regions":
    [
      { "name": "TFM_PERIPHERAL_SPIM22", "permission": "READ-WRITE" },
      { "name": "TFM_PERIPHERAL_PWM21", "permission": "READ-WRITE" },
      { "name": "TFM_PERIPHERAL_TIMER22", "permission": "READ-WRITE" },
    ],
  "irqs":
    [
      {
        "source": "TFM_TIMER22_IRQ",
        "name": "TFM_TIMER22_IRQ",
        "handling": "SLIH",
      },
    ],
  # ITS for the panel config, read in tfm_bitcoin_init(). TF-M loads a partition after the
  # ones it depends on.
  "dependencies":
    ["TFM_CRYPTO", "TFM_PROTECTED_STORAGE_SERVICE", "TFM_INTERNAL_TRUSTED_STORAGE_SERVICE"],
}
